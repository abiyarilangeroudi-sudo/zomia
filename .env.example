APP_ENV=local

POSTGRES_DB=zomia
POSTGRES_USER=zomia
POSTGRES_PASSWORD=zomia_local_password
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://zomia:zomia_local_password@localhost:5432/zomia
JWT_SECRET_KEY=replace-with-a-long-random-local-secret
JWT_ISSUER=zomia-api
ACCESS_TOKEN_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
