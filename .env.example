APP_ENV=local

POSTGRES_DB=zomia
POSTGRES_USER=zomia
POSTGRES_PASSWORD=zomia_local_password
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://zomia:zomia_local_password@localhost:5432/zomia
JWT_SECRET_KEY=replace-with-a-long-random-local-secret
JWT_ISSUER=zomia-api
ACCESS_TOKEN_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

EMAIL_DELIVERY_MODE=smtp
OTP_EXPIRES_MINUTES=10
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=587
SMTP_USERNAME=info@zomia.eu
SMTP_PASSWORD=replace-with-zoho-app-password
SMTP_FROM_EMAIL=noreply@zomia.eu
SMTP_FROM_NAME=Zomia
SMTP_USE_TLS=true
